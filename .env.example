# Life OS — environment template
# Copy to .env.local and fill in values:
#   cp .env.example .env.local
# Never commit .env or .env.local

# =============================================================================
# LLM — Google Gemini (active)
# =============================================================================
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# Optional Gemini tuning (safe defaults)
# GEMINI_TEMPERATURE=0.2
# GEMINI_MAX_OUTPUT_TOKENS=8192

# =============================================================================
# App runtime
# =============================================================================
# LIFE_OS_ENV=development
# LIFE_OS_LOG_LEVEL=INFO
# LIFE_OS_CONFIDENCE_THRESHOLD=0.7
# LIFE_OS_DRY_RUN=false
# LIFE_OS_DEFAULT_TZ=America/Los_Angeles

# =============================================================================
# Integrations — add as we wire them (leave blank until needed)
# =============================================================================

# --- Google (Gmail / Calendar / Sheets OAuth) ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_TOKEN_PATH=.oauth/google_token.json
# GOOGLE_CALENDAR_ID=primary
# SHEETS_SPREADSHEET_ID=

# --- Notion ---
# NOTION_TOKEN=
# NOTION_PARENT_PAGE_ID=
# NOTION_DATABASE_ID=

# --- Slack ---
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=
# SLACK_SIGNING_SECRET=

# --- Optional observability ---
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=life-os

# Life OS — environment template
# Copy to .env (and optionally .env.local) and fill in values.
# Never commit .env or .env.local

# =============================================================================
# LLM — Google Gemini (default) / Anthropic optional
# =============================================================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash

# Optional Gemini tuning (safe defaults)
# GEMINI_TEMPERATURE=0.2
# GEMINI_MAX_OUTPUT_TOKENS=8192

# Optional Anthropic (set LLM_PROVIDER=anthropic to use)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8

# =============================================================================
# App runtime
# =============================================================================
# LIFE_OS_ENV=development
# LIFE_OS_LOG_LEVEL=INFO
# LIFE_OS_CONFIDENCE_THRESHOLD=0.7
# LIFE_OS_DRY_RUN=false
# LIFE_OS_DEFAULT_TZ=America/Los_Angeles

# Agent 2 connectors — mock by default (deterministic; no network)
LIFE_OS_USE_MOCK_CONNECTORS=1
# Sandbox per-user Gmail/Calendar worlds (on by default when mocks are on)
# LIFE_OS_USE_SANDBOX=1
# LIFE_OS_USE_SANDBOX=0   # ephemeral mocks only, no sandbox JSON writes
# HITL_POLICY=primary
# HITL_FALLBACK_CLI=1
# LIFE_OS_HITL_AUTO=          # tests only: approve|deny (skips stdin)

# =============================================================================
# Family Admin roster (≤10) — per-user OAuth tokens
# =============================================================================
FAMILY_ID=hauns
ADMIN_MAX=10
HITL_POLICY=any_of
ADMIN_IDS=admin_01,admin_02,admin_03,admin_04,admin_05,admin_06,admin_07,admin_08,admin_09,admin_10

ADMIN_01_NAME=Alex Chen
ADMIN_01_ROLE=owner
ADMIN_01_EMAIL=alex@lifeos.sandbox
ADMIN_01_SLACK=U_ALEX
ADMIN_01_GOOGLE_TOKEN_PATH=.oauth/admin_01_google.json
# ADMIN_01_NOTION_TOKEN=

ADMIN_02_NAME=Jordan Lee
ADMIN_02_ROLE=operator
ADMIN_02_EMAIL=jordan@lifeos.sandbox
ADMIN_02_SLACK=U_JORDAN
ADMIN_02_GOOGLE_TOKEN_PATH=.oauth/admin_02_google.json

ADMIN_03_NAME=Sam Rivera
ADMIN_03_ROLE=operator
ADMIN_03_EMAIL=sam@lifeos.sandbox


# Life OS — environment template
# Copy to .env.local and fill in values:
#   cp .env.example .env.local
# Never commit .env or .env.local

# =============================================================================
# LLM — Google Gemini (default) / Anthropic optional
# =============================================================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-3.6-flash

# Optional Gemini tuning (safe defaults)
# GEMINI_TEMPERATURE=0.2
# GEMINI_MAX_OUTPUT_TOKENS=8192

# Optional Anthropic (set LLM_PROVIDER=anthropic to use)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8

# =============================================================================
# App runtime
# =============================================================================
# LIFE_OS_ENV=development
# LIFE_OS_LOG_LEVEL=INFO
# LIFE_OS_CONFIDENCE_THRESHOLD=0.7
# LIFE_OS_DRY_RUN=false
# LIFE_OS_DEFAULT_TZ=America/Los_Angeles

# Agent 2 connectors — mock by default (deterministic; no network)
LIFE_OS_USE_MOCK_CONNECTORS=1
# HITL_POLICY=primary
# HITL_FALLBACK_CLI=1
# LIFE_OS_HITL_AUTO=          # tests only: approve|deny (skips stdin)
# ADMIN_PRIMARY_SLACK=        # Slack user id for Primary Admin @mention

# =============================================================================
# Integrations — Agent 2 (set LIFE_OS_USE_MOCK_CONNECTORS=0 for live writes)
# =============================================================================

# --- Google (Gmail / Calendar / Sheets OAuth) ---
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_TOKEN_PATH=.oauth/google_token.json
# GOOGLE_CALENDAR_ID=primary
# SHEETS_SPREADSHEET_ID=
# SHEETS_AUDIT_RANGE=Audit!A:Z

# --- Notion ---
# NOTION_TOKEN=
# NOTION_PARENT_PAGE_ID=
# NOTION_DATABASE_ID=

# --- Slack ---
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=
# SLACK_SIGNING_SECRET=

# --- Optional observability ---
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=life-os
